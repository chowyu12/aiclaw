FROM node:22-bookworm-slim AS node-runtime
FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 python3-gi gir1.2-atspi-2.0 gir1.2-gtk-3.0 gir1.2-webkit2-4.1 xvfb xauth dbus-x11 \
    openbox xcompmgr libxtst6 libxcomposite1 fonts-dejavu-core libnss3 libasound2 libgbm1 \
    && rm -rf /var/lib/apt/lists/*
ENV NO_AT_BRIDGE=0 GTK_MODULES=atk-bridge
WORKDIR /computer-use
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends at-spi2-core nodejs \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
