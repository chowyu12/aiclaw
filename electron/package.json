{
  "name": "aiclaw-electron",
  "version": "0.0.0",
  "private": true,
  "description": "Electron shell for AIClaw",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "build:core": "node tools/build-core.mjs $npm_config_platform",
    "build:renderer": "npm --prefix ../renderer run build",
    "package": "npm run build && npm run build:renderer && node tools/build-core.mjs $(node -p process.platform) && electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
