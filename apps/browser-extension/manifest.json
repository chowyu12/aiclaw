{
  "manifest_version": 3,
  "name": "AIClaw 浏览器助手",
  "version": "1.1.1",
  "description": "让本机的 AIClaw 在后台标签页里替你浏览网页：用你已有的登录，不抢鼠标。只连本机的 AIClaw，需要配对码。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "AIClaw 浏览器助手", "default_popup": "popup.html" },
  "icons": { "128": "icon128.png" }
}
