{
  "name": "@aiclaw/desktop",
  "version": "3.12.5",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && esbuild src/main/document-worker.ts --bundle --platform=node --target=node22 --format=cjs --external:unpdf --external:7z-wasm --external:pdfjs-dist --outfile=dist/main/document-worker.cjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json && vue-tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "build:preload": "esbuild src/preload/index.cts src/preload/computer-overlay.cts --bundle --platform=node --target=node20 --format=cjs --external:electron --outdir=dist/preload --out-extension:.js=.cjs"
  },
  "dependencies": {
    "@aiclaw/agent-client": "*",
    "@trycua/cua-driver": "0.49.0",
    "7z-wasm": "1.2.0",
    "fflate": "0.8.2",
    "highlight.js": "11.12.0",
    "pdfjs-dist": "5.4.530",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "45.2.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5"
  }
}
