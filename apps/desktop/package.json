{
  "name": "@aiclaw/desktop",
  "version": "3.5.6",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json && vue-tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "build:preload": "esbuild src/preload/index.cts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/index.cjs"
  },
  "dependencies": {
    "@aiclaw/agent-client": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^40.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5",
    "esbuild": "^0.28.2"
  }
}
